# --- Database ---
# Postgres (free tier — Neon works fine, same as the CRM project). In
# Vercel this is usually set automatically by the Neon integration.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon's non-pooled ("Direct connection") string — required alongside
# DATABASE_URL once that's the pooled ("-pooler") one, for `prisma migrate
# deploy` (see schema.prisma). A plain local Postgres can reuse the same
# value as DATABASE_URL here.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (NextAuth.js) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin login ---
# Single admin account (you) — no user table, just these two env vars.
# Generate the hash with `npm run hash-password -- 'your-password'`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

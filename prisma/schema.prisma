// Postgres (free tier — Neon, same pattern as the CRM project). Fields are
// plain strings/string-arrays rather than native enums, validated in
// application code — keeps the schema simple for a single-editor site.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (the "-pooler" hostname, used by DATABASE_URL
  // for normal app traffic) is PgBouncer in transaction mode, which drops
  // the session between statements -- `prisma migrate deploy`'s advisory
  // lock times out against it (P1002). DIRECT_URL is Neon's non-pooled
  // connection string, used only by Prisma's CLI/migration commands.
  directUrl = env("DIRECT_URL")
}

// One showcased project — the CRM is the first row, 5 more get added the
// same way (via /admin, or a future import script) without any schema
// change. `whitepaper` is the long-form case-study content (Markdown,
// rendered with react-markdown on the public page); `summary` is the
// short blurb shown on the gallery card.
model Platform {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String?
  summary       String?  @db.Text
  category      String?
  tags          String[] @default([])
  techStack     String[] @default([])
  highlights    String[] @default([])
  liveUrl       String?
  repoUrl       String?
  // Emoji fallback, kept for old rows / optional future use — the public
  // pages no longer render this (they show a generated initials badge
  // instead; see PlatformCard.tsx). coverImageUrl overrides the badge
  // once a real image exists somewhere reachable (S3, Vercel Blob, etc.
  // — not stored here).
  iconEmoji     String?
  coverImageUrl String?
  // Accessible alt text for coverImageUrl — kept separate from imageCaption
  // because they serve different readers: alt text describes the image for
  // someone who can't see it, the caption is visible copy for everyone,
  // explaining what the image actually is (e.g. "Representative interface
  // with fictional prospects") so a generated mockup is never mistaken for
  // a real screenshot.
  imageAlt      String?
  imageCaption  String?
  // Whether the whitepaper page embeds `liveUrl` in a live iframe preview.
  // Defaults on; flip off per-platform from /admin if a site's own
  // X-Frame-Options/CSP refuses to be framed (the "Launch demo" button
  // still works regardless — this only controls the in-page preview).
  embeddable    Boolean  @default(true)
  // Path to a locally-hosted, self-contained interactive demo (e.g. a
  // static HTML tool under /public) that opens in an accessible modal via
  // InteractiveDemoModal — distinct from liveUrl, which is an external
  // hosted product. Null for every platform except ones with a bespoke
  // interactive artifact worth exploring in place.
  interactiveDemoUrl String?
  whitepaper    String   @db.Text
  // Content-facing maturity label shown to visitors — "Internal tool",
  // "Prototype", "Public platform", "GTM system", "AI workflow", etc.
  // Deliberately a separate field from `status` below: this is what a
  // project *is*, that field is whether the row is visible at all. Mixing
  // the two would mean a project's visibility state and its actual nature
  // fight over the same word.
  displayStatus String?
  // DRAFT | PUBLISHED — only PUBLISHED rows show on the public site;
  // DRAFT lets a platform be prepared in the admin before it's ready to
  // show anyone.
  status        String   @default("DRAFT")
  // Slugs of other Platform rows this one is related to (e.g. two builds
  // documented as related/lineage rather than fully independent) — shown
  // as cross-links on the detail page so the relationship is explicit
  // instead of implied by two similar-sounding names.
  relatedProjectSlugs String[] @default([])
  // Manual display order on the gallery (lower first) — set from the
  // admin list via up/down controls, not auto-computed.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

// Single editable row for every piece of site-wide homepage copy that
// isn't tied to a specific platform — hero, the gallery section intro,
// About, and Contact. A true singleton: always read/written by the fixed
// id "singleton" (see prisma/seed.ts and the /admin/site route), rather
// than a separate table-with-one-row convention or a settings key/value
// table, since every field here is known upfront and unlikely to grow
// unbounded the way platforms do.
model SiteContent {
  id               String   @id @default("singleton")
  siteName         String   @default("Showcase")
  siteTagline      String   @default("")
  heroHeading      String   @db.Text
  // Paragraphs separated by a blank line — split on "\n\n" when rendered,
  // same convention as aboutBody below, so the admin form is just one
  // textarea instead of a fixed, arbitrary number of paragraph fields.
  heroIntro        String   @db.Text
  heroPrimaryCta   String
  heroSecondaryCta String
  sectionHeading   String
  sectionBody      String   @db.Text
  aboutHeading     String
  aboutBody        String   @db.Text
  contactHeading   String
  contactBody      String   @db.Text
  contactCtaLabel  String
  // Blank until set from /admin — never invented or defaulted to a real
  // address by seed/migration code. The homepage's contact button renders
  // as a disabled label until this is filled in.
  contactEmail     String?
  updatedAt        DateTime @updatedAt
}
